# ==========================================
# Discord Bot Credentials
# ==========================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ==========================================
# Gemini / LLM API Configuration
# ==========================================
# Your Google Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The model to call via OpenAI-compatible endpoint
# Model specified: GEMMA4 31B (Instruction-tuned)
AI_MODEL=gemma-4-31b-it

# OpenAI compatible endpoint for Google Gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: System prompt customization or temperature
AI_TEMPERATURE=0.2

# ==========================================
# Bot Operational Settings
# ==========================================
BOT_PREFIX=!

# Comma-separated Discord Role IDs allowed to execute admin actions
# If left empty, ANY user with Discord "Administrator" permission can use it
ALLOWED_ROLE_IDS=

# Channel ID where the bot logs every administrative tool execution
LOG_CHANNEL_ID=

# Number of past channel messages to feed into AI context for conversational continuity
CONTEXT_WINDOW_SIZE=10

# Require interactive button confirmation for destructive actions (True/False)
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# Channel ID where any message sent automatically becomes the sender's server nickname.
# The bot will NEVER reply in this channel, even if pinged.
AUTO_NICKNAME_CHANNEL_ID=
